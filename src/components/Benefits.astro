---
import SectionLabel from "./SectionLabel.astro";
import { benefits } from "../content/landing";
---

<section>
  <div class="mx-auto flex max-w-page flex-col gap-6 px-6 py-16 md:gap-12 md:px-10 md:py-28">
    <div class="flex flex-col gap-6 md:gap-5">
      <SectionLabel>{benefits.label}</SectionLabel>
      <h2 class="text-heading font-medium text-balance">{benefits.title}</h2>
    </div>

    <ul class="grid gap-2.5 md:grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] md:gap-3">
      {
        benefits.items.map((item) => (
          <li class="flex flex-col gap-2 rounded-card bg-white px-4.5 py-5 shadow-card md:gap-2.5 md:px-6 md:py-7">
            <span
              aria-hidden="true"
              class="h-1 w-7 rounded-bar bg-linear-to-r/srgb from-indigo to-orange md:mb-2 md:w-8"
            />
            <h3 class="text-benefit-title font-semibold text-balance">{item.title}</h3>
            <p class="text-benefit-text text-ink-2">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
