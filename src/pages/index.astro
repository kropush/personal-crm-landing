---
import "../styles/global.css";
import Benefits from "../components/Benefits.astro";
import FinalCta from "../components/FinalCta.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Problems from "../components/Problems.astro";
import { THEME_COLOR } from "../config";
import { meta } from "../content/landing";

const fonts = [
  "inter-tight-cyrillic",
  "inter-tight-latin",
  "jetbrains-mono-cyrillic",
  "jetbrains-mono-latin",
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The contact card shows a sample phone number; keep iOS from turning it into a link -->
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content={THEME_COLOR} />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {fonts.map((font) => <link rel="preload" href={`/fonts/${font}.woff2`} as="font" type="font/woff2" crossorigin />)}
  </head>
  <body>
    <main>
      <Hero />
      <Problems />
      <HowItWorks />
      <Benefits />
      <FinalCta />
    </main>
  </body>
</html>
